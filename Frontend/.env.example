PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:3000/api
NEXT_PUBLIC_WS_URL=ws://localhost:3000/api/v1/ws
NEXT_PUBLIC_WS_ENABLED=true
NEXT_PUBLIC_CHAT_ENABLED=true
# Google sign-in: OAuth 2.0 Web client ID from Google Cloud Console.
# Must match GOOGLE_CLIENT_ID on the backend. Leave empty to hide the button.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
# Auto-start CSV ball replay for LIVE matches (no admin panel needed)
NEXT_PUBLIC_SIMULATOR_AUTO_START=true
